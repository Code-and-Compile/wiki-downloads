    {
        "id": "7686cd95cfa4e0f8",
        "type": "function",
        "z": "58db5e21f49ecded",
        "name": "save in flow variable",
        "func": "const topic = msg.topic || \"\";\nconst value = msg.payload;\n\n// Extract variable name from the end of the topic string\n// e.g. \"ns=4;s=|var|...PLC_PRG.rX_VRMS : msg.payload : number\" → \"rX_VRMS\"\nconst parts = topic.split(\".\");\nconst varPart = parts[parts.length - 1].split(\" \")[0]; // get \"rX_VRMS\" etc.\n\nif (varPart === \"iVibrationState\") {\n    flow.set(\"iVibrationState\", value);\n    msg.topic = \"iVibrationState\";\n} else if (varPart === \"rTemp\") {\n    flow.set(\"rTemp\", Number(value.toFixed(2)));\n    msg.topic = \"rTemp\";\n} else if (varPart === \"rX_VRMS\") {\n    flow.set(\"rX_VRMS\", Number(value.toFixed(2)));\n    msg.topic = \"rX_VRMS\";\n} else if (varPart === \"rY_VRMS\") {\n    flow.set(\"rY_VRMS\", Number(value.toFixed(2)));\n    msg.topic = \"rY_VRMS\";\n} else if (varPart === \"rZ_VRMS\") {\n    flow.set(\"rZ_VRMS\", Number(value.toFixed(2)));\n    msg.topic = \"rZ_VRMS\";\n} else if (varPart === \"rMaxVib\") {\n    flow.set(\"rMaxVib\", Number(value.toFixed(2)));\n    msg.topic = \"rMaxVib\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 820,
        "y": 300,
        "wires": [
            [
                "e31e4611d1aa1ee8"
            ]
        ]
    },
    {
        "id": "e31e4611d1aa1ee8",
        "type": "function",
        "z": "58db5e21f49ecded",
        "name": "Route to Dashboard",
        "func": "const xVal = flow.get(\"rX_VRMS\");\nconst yVal = flow.get(\"rY_VRMS\");\nconst zVal = flow.get(\"rZ_VRMS\");\n\nnode.send([\n    { payload: xVal },                                          // X-VRMS gauge\n    { payload: yVal },                                          // Y-VRMS gauge\n    { payload: zVal },                                          // Z-VRMS gauge\n    { payload: flow.get(\"rTemp\") },                            // Temperature gauge\n    { payload: xVal, topic: \"X-VRMS\" },                       // Combined trend\n    { payload: yVal, topic: \"Y-VRMS\" },                       // Combined trend\n    { payload: zVal, topic: \"Z-VRMS\" },                       // Combined trend\n    {\n        payload: (() => {\n            const state = flow.get(\"iVibrationState\");\n            if (state === 0) return 'System operating within normal parameters';\n            if (state === 1) return 'Warning: Elevated vibration detected';\n            if (state === 2) return 'Critical: Vibration exceeds safe limits';\n        })()\n    }                                                      // System status\n]);",
        "outputs": 8,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1080,
        "y": 300,
        "wires": [
